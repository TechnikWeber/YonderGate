[Unit]
Description=go2rtc (YonderGate video)
After=network.target

[Service]
Type=simple
# The config is GENERATED by the vehicle service from the camera settings, so it
# lives in /var/lib — not in the git checkout, which it would dirty on every start
# and thereby block every `git pull --ff-only`. Keep this path identical to
# YGW_GO2RTC_CONFIG in yondergate.service.
ExecStart=/usr/local/bin/go2rtc -config /var/lib/yondergate/go2rtc.yaml
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
